# Copy this file to `.env` (never commit `.env` — it's already in .gitignore) and fill in
# the values for whichever provider you chose in Chapter 1.
#
# The one-time setup — creating a provider account, setting a spend limit (recommended
# $15-20 for the whole course) BEFORE generating a key, and generating the key itself — is
# walked through step by step in curriculum/01_fundamentals.ipynb. Do that first; this file
# just tells the rest of the course (Chapters 2, 3, 4, 6, 7, and the capstone, all of which
# reuse agentlib/llm_client.py) which provider and key to use, so you only ever set this up
# once.

# Either "anthropic" or "openai" — pick one. Everything else in the course reads this single
# variable and never needs to know which provider you picked.
LLM_PROVIDER=anthropic

# Only the key matching LLM_PROVIDER above needs a real value. It's fine to leave the other
# one blank, or fill in both if you want to be able to switch providers later without
# re-running setup.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
